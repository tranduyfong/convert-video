BRAND_NAME=TubeGo
SITE_URL=http://localhost:3000
PORT=3000
MAX_CONCURRENT=2
MAX_WAITING=8
MAX_ANALYSES=3
MAX_DURATION_SECONDS=360
MAX_FILE_MB=256
JOB_TIMEOUT_SECONDS=600
FILE_TTL_SECONDS=900
# Local: set absolute paths if the programs are not on PATH.
YT_DLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
TEMP_ROOT=.tmp
# Direct connections: leave empty. Reverse proxy: see README.
TRUST_PROXY=
